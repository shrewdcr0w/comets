{
  "manifest_version": 3,
  "name": "comets",
  "version": "1.0.0",
  "description": "Floating command snippet manager and cheat sheet.",
  
    "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
    "action": {
    "default_icon": "icons/icon-64.png",
    "default_title": "Open comets"
  },
  
  "background": {
    "service_worker": "background.js"
  },
    "web_accessible_resources": [
    {
      "resources": ["data/snippets.json"],
      "matches": ["<all_urls>"]
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  
  "permissions": [
    "storage",
    "clipboardWrite"
  ]
}